# 1. Создаем базовый тактовый сигнал
# Указываем, что на входной порт "CLK" подается сигнал с частотой 50 МГц (период 20 нс)
create_clock -name CLK -period 20.000 [get_ports {CLK}]

# 2. Автоматически создаем ограничения для PLL
# Эта команда автоматически создаст ограничение для тактового сигнала на выходе вашего PLL
derive_pll_clocks

# 3. Задаем неопределенность тактового сигнала
# Это очень важная команда, которая учитывает джиттер PLL и другие факторы
derive_clock_uncertainty

# 4. Задаем задержки для входных и выходных сигналов (I/O constraints)
# Для UART это не критично, но является хорошей практикой
# Предполагаем, что внешние устройства имеют задержку 10 нс
set_input_delay -clock CLK -max 10.000 [get_ports {Rx}]
set_output_delay -clock CLK -max 10.000 [get_ports {Tx}]