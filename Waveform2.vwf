/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off transmitter -c transmitter --vector_source="/home/shatoo/Desktop/ofigevaem/Waveform2.vwf" --testbench_file="/home/shatoo/Desktop/ofigevaem/simulation/qsim/Waveform2.vwf.vt"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off transmitter -c transmitter --vector_source="/home/shatoo/Desktop/ofigevaem/Waveform2.vwf" --testbench_file="/home/shatoo/Desktop/ofigevaem/simulation/qsim/Waveform2.vwf.vt"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=verilog --output_directory="/home/shatoo/Desktop/ofigevaem/simulation/qsim/" transmitter -c transmitter</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="/home/shatoo/Desktop/ofigevaem/simulation/qsim/" transmitter -c transmitter</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vlog -work work transmitter.vo
vlog -work work Waveform2.vwf.vt
vsim  -c -t 1ps -L cycloneive_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.Receiv_vlg_vec_tst
vcd file -direction transmitter.msim.vcd
vcd add -internal Receiv_vlg_vec_tst/*
vcd add -internal Receiv_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vlog -work work transmitter.vo
vlog -work work Waveform2.vwf.vt
vsim -novopt -c -t 1ps -L cycloneive_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.Receiv_vlg_vec_tst
vcd file -direction transmitter.msim.vcd
vcd add -internal Receiv_vlg_vec_tst/*
vcd add -internal Receiv_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f

</modelsim_script_timing>
<hdl_lang>verilog</hdl_lang>
</simulation_settings>*/
