`timescale 1 ps/ 1 ps
module ConfigCD_vlg_vec_tst();
// constants                                           
// general purpose registers
reg C;
reg conf_ready;
reg config_start;
reg Tf;
// wires                                               
wire LoadREG;
wire PerifConfig;

// assign statements (if any)                          
ConfigCD i1 (
// port map - connection between master ports and signals/registers   
	.C(C),
	.conf_ready(conf_ready),
	.config_start(config_start),
	.LoadREG(LoadREG),
	.PerifConfig(PerifConfig),
	.Tf(Tf)
);
initial 
begin 
#1000000 $finish;
end 

// C
always
begin
	C = 1'b0;
	C = #5000 1'b1;
	#5000;
end 

// config_start
initial
begin
	config_start = 1'b0;
	config_start = #55000 1'b1;
	config_start = #10000 1'b0;
end 

// Tf
initial
begin
	Tf = 1'b0;
	Tf = #95000 1'b1;
	Tf = #45000 1'b0;
end 

// conf_ready
initial
begin
	conf_ready = 1'b0;
	conf_ready = #125000 1'b1;
	conf_ready = #145000 1'b0;
end 
endmodule

