module devider #(parameter WIDTH = 16)
	(input wire clk_50MHz,
	input wire [WIDTH-1:0] devider,
	input wire rst,
	output reg CE);
	
	
	reg [WIDTH-1:0] cnt;
	initial begin
		cnt = 0;
	end
	
	always @(posedge clk)begin
		if(&cnt)begin
			cnt <= devider -1;
		end else begin
			cnt <= cnt -1;
		end
	end
	

	endmodule